#!/bin/sh

if [ -n "$CI" ] || [ -n "$GITHUB_ACTIONS" ]; then
  echo ""
  echo "========================================"
  echo "   CI ENVIRONMENT DETECTED - SKIPPING   "
  echo "========================================"
  echo ""
  exit 0
fi

echo ""
echo "========================================"
echo "             PRE-PUSH CHECKS             "
echo "========================================"

echo "Running type check..."
pnpm run typecheck
status=$?

if [ $status -ne 0 ]; then
  echo ""
  echo "----------------------------------------"
  echo "✗ Type check failed. Push aborted."
  echo "Please fix type errors before pushing."
  echo "----------------------------------------"
  exit 1
fi

echo "Running unit tests..."
pnpm run test
status=$?

if [ $status -ne 0 ]; then
  echo ""
  echo "----------------------------------------"
  echo "✗ Unit tests failed. Push aborted."
  echo "Please fix failing tests before pushing."
  echo "----------------------------------------"
  exit 1
fi

echo ""
echo "----------------------------------------"
  echo "✓ All pre-push checks passed."
echo "----------------------------------------"
echo ""
exit 0
