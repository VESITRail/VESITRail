{
	"private": true,
	"type": "module",
	"name": "vesitrail",
	"author": "VESITRail",
	"packageManager": "pnpm@12.4.2",
	"version": "0.0.0-semantically-released",
	"homepage": "https://rail.vesit.ves.ac.in",
	"engines": {
		"node": "24.x"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/VESITRail/VESITRail.git"
	},
	"description": "Apply for railway student concessions online with ease! Enjoy a smooth application process and real-time tracking - Made for VESIT students.",
	"release": {
		"branches": [
			"main"
		]
	},
	"lint-staged": {
		"package.json": [
			"prettier --write"
		],
		"*.{js,jsx,ts,tsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,md,yml,yaml,css}": [
			"prettier --write"
		],
		"*.prisma": [
			"pnpm exec prisma format"
		]
	},
	"scripts": {
		"dev": "next dev",
		"lint": "eslint .",
		"prepare": "husky",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"format": "prettier . --write",
		"build": "next build --webpack",
		"format:check": "prettier . --check",
		"semantic-release": "semantic-release",
		"test:unit": "vitest run --project unit",
		"test:unit:watch": "vitest --project unit",
		"labels:sync": "pnpm exec tsx scripts/sync-labels.ts",
		"test:integration": "vitest run --project integration",
		"start": "pnpm exec prisma migrate deploy && next start",
		"test:integration:watch": "vitest --project integration",
		"test:unit:coverage": "vitest run --project unit --coverage",
		"test:integration:coverage": "vitest run --project integration --coverage",
		"postinstall": "pnpm exec tsx scripts/generate.ts && pnpm exec tsx scripts/fix-zod-types.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1149.0",
		"@aws-sdk/s3-request-presigner": "^3.1149.0",
		"@hookform/resolvers": "^5.9.1",
		"@icons-pack/react-simple-icons": "^13.15.1",
		"@next/third-parties": "^16.4.0",
		"@prisma/client": "^7.2.0",
		"@prisma/nextjs-monorepo-workaround-plugin": "^7.10.0",
		"@radix-ui/react-alert-dialog": "^1.2.1",
		"@radix-ui/react-avatar": "^1.3.1",
		"@radix-ui/react-checkbox": "^1.4.1",
		"@radix-ui/react-collapsible": "^1.2.1",
		"@radix-ui/react-dialog": "^1.3.1",
		"@radix-ui/react-dropdown-menu": "^2.2.1",
		"@radix-ui/react-label": "^2.1.17",
		"@radix-ui/react-navigation-menu": "^1.4.1",
		"@radix-ui/react-popover": "^1.3.1",
		"@radix-ui/react-progress": "^1.2.1",
		"@radix-ui/react-radio-group": "^1.5.1",
		"@radix-ui/react-scroll-area": "^1.4.0",
		"@radix-ui/react-select": "^2.4.1",
		"@radix-ui/react-separator": "^1.2.0",
		"@radix-ui/react-slot": "^1.5.0",
		"@radix-ui/react-switch": "^1.4.1",
		"@radix-ui/react-tooltip": "^1.4.1",
		"@serwist/build": "^9.5.13",
		"@serwist/next": "^9.5.13",
		"@serwist/sw": "^9.5.13",
		"@tanstack/react-table": "^8.21.3",
		"@types/nodemailer": "^8.0.2",
		"better-auth": "^1.7.7",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.4.0",
		"date-fns-tz": "^3.2.0",
		"eslint-config-prettier": "^10.1.8",
		"firebase": "^12.19.0",
		"firebase-admin": "^14.5.0",
		"framer-motion": "^14.1.0",
		"jspdf": "^4.2.1",
		"jspdf-autotable": "^5.0.8",
		"lucide-react": "^1.58.0",
		"nanoid": "^6.0.2",
		"next": "16.4.0",
		"next-themes": "^0.4.6",
		"nextjs-toploader": "^3.9.17",
		"nodemailer": "^10.1.0",
		"pdf-lib": "^1.17.1",
		"pg": "^8.23.1",
		"posthog-js": "^1.438.7",
		"posthog-node": "^5.55.2",
		"react": "^19.3.0",
		"react-day-picker": "^10.0.2",
		"react-dom": "^19.3.0",
		"react-hook-form": "^7.90.0",
		"react-markdown": "^10.1.0",
		"serwist": "^9.5.11",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.6.0",
		"vaul": "^1.1.2",
		"zod": "^4.6.6",
		"zod-prisma-types": "^3.3.11"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.7",
		"@eslint/js": "^10.0.1",
		"@prisma/adapter-pg": "^7.10.0",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^26.6.5",
		"@types/pg": "^8.23.1",
		"@types/react": "^19",
		"@types/react-dom": "^19.3.0",
		"@vitest/coverage-v8": "^3.2.1",
		"dotenv": "^18.0.7",
		"eslint": "^9.39.2",
		"eslint-config-flat-gitignore": "^2.4.0",
		"eslint-config-next": "^16.4.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"prisma": "^7.2.0",
		"semantic-release": "^25.0.9",
		"tailwindcss": "^4",
		"tsx": "^4.23.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.71.1",
		"vitest": "^3.2.1"
	}
}
